// ============================================================
// remote-boot.js — CW Framework loader from hub (isomorphic)
// Browser: <script src="https://hub-cf.i771468.workers.dev/remote-boot.js"></script>
//          loads framework + HTML components + widgets (as before)
// Node:    evaluate this file, then: await CW_loadFramework(hub?)
//          hub = URL ('https://…/') or local folder ('/path/to/dir/')
// Worker:  cannot load code at runtime (no eval) — bundle the FILES
//          list below at deploy time instead
// ============================================================

(() => {
  const HUB = 'https://hub-cf.i771468.workers.dev/'

  // single source of truth for load order
  const FILES = [
    'CW-state.js',
    'CW-config.js',
    'CW-utils.js',
    'CW-run.js',
    'CW-adapter-d1.js',
    'boot.js'
  ]

  const isBrowser =
    typeof window !== 'undefined' && typeof document !== 'undefined'

  // ── load the framework files, in order ─────────────────────
  async function loadFramework(hub = HUB) {
    for (const src of FILES) {
      if (isBrowser) {
        await new Promise((resolve, reject) => {
          const s = document.createElement('script')
          s.src = hub + src
          s.onload = resolve
          s.onerror = reject
          document.head.appendChild(s)
        })
        continue
      }

      // Node: needs vm (+ fs for a local folder)
      const gb = globalThis.process?.getBuiltinModule
      if (!gb) {
        throw new Error(
          'remote-boot: cannot load code at runtime here (Worker?) — bundle the framework files instead'
        )
      }
      const vm = gb('node:vm')
      let code
      if (/^https?:/.test(hub)) {
        const r = await fetch(hub + src)
        if (!r.ok) throw new Error(`remote-boot: ${src} → ${r.status}`)
        code = await r.text()
      } else {
        code = gb('node:fs').readFileSync(hub + src, 'utf8')
      }
      vm.runInThisContext(code, { filename: src })
    }
  }

  globalThis.CW_loadFramework = loadFramework
  globalThis.CW_FRAMEWORK_FILES = FILES

  if (!isBrowser) return

  // ============================================================
  // Browser only: components + widgets
  // ============================================================
  ;(async () => {
    const SITE = window.location.origin + '/'

    // ── 0. Fire HTML component fetches IMMEDIATELY ───────────
    //        Runs in parallel with the framework download so
    //        /navbar.html is requested within milliseconds of
    //        remote-boot.js executing.
    const slots = [...document.querySelectorAll('[id]')]
      .filter(el => !el.innerHTML.trim())

    const htmlReady = Promise.all(slots.map(el =>
      fetch(SITE + el.id + '.html', { credentials: 'same-origin' })
        .then(r => (r.ok ? r.text() : ''))
        .then(html => {
          if (html && el && !el.innerHTML.trim()) {
            el.innerHTML = html
            document.dispatchEvent(new CustomEvent('component:ready', {
              detail: { id: el.id }
            }))
          }
        })
        .catch(() => {})
    ))

    // ── 1. Load CW framework IN PARALLEL ─────────────────────
    const frameworkReady = loadFramework()

    // ── 2. Wait until the HTML components have been injected ─
    await htmlReady

    // ── 3. Widgets — site first, hub fallback ────────────────
    for (const el of [...document.querySelectorAll('[id]')]
          .filter(el => !el.innerHTML.trim())) {
      await new Promise(resolve => {
        const s = document.createElement('script')
        s.src = SITE + el.id + '.js'
        s.onload = resolve
        s.onerror = () => {
          const fallback = document.createElement('script')
          fallback.src = HUB + el.id + '.js'
          fallback.onload = resolve
          fallback.onerror = resolve
          document.head.appendChild(fallback)
        }
        document.head.appendChild(s)
      })
    }

    // ── 4. Ensure framework finished before signalling "done" ─
    await frameworkReady
    document.dispatchEvent(new Event('components:ready'))
  })()
})()
